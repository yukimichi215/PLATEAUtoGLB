{
  "name": "plateau-to-glb",
  "version": "0.1.0",
  "private": true,
  "description": "PLATEAU の3D都市モデルから、住所の周りの建物を 3D モデル（GLB・OBJ・STL）にするツール",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx scripts/cli.ts",
    "verify": "tsx scripts/verify-glb.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "earcut": "^3.2.4",
    "leaflet": "1.9.4",
    "manifold-3d": "3.5.4",
    "sax": "^1.6.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.5",
    "@types/sax": "^1.2.7",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
